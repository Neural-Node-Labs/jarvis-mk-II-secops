    {
      "name": "file_streamer",
      "description": "Handles large file payloads by allowing chunked, segmented appending to bypass LLM max_token generation constraints. Essential for writing files that exceed single-turn output limits.",
      "actions": [
        "start_file",
        "append_chunk",
        "finalize_file"
      ],
      "action_schemas": {
        "start_file": {
          "description": "Create (or overwrite) the target file and open a stream session.",
          "params": {
            "path": {
              "type": "string",
              "required": true,
              "description": "Destination file path (relative or absolute). Parent directories are created automatically."
            },
            "overwrite": {
              "type": "boolean",
              "required": false,
              "default": false,
              "description": "If false (default), returns an error when the file already exists. Set true to truncate and replace."
            }
          },
          "returns": {
            "path": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "stream_opened"
              ]
            },
            "bytes_written": {
              "type": "integer"
            }
          }
        },
        "append_chunk": {
          "description": "Append a text chunk to a previously opened stream. Call repeatedly until all content is written.",
          "params": {
            "path": {
              "type": "string",
              "required": true,
              "description": "Must match the path used in the corresponding start_file call."
            },
            "content": {
              "type": "string",
              "required": true,
              "description": "Raw text content to append. No size restriction \u2014 split across as many turns as needed."
            }
          },
          "returns": {
            "path": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "chunk_appended"
              ]
            },
            "chunk_bytes": {
              "type": "integer"
            },
            "total_bytes": {
              "type": "integer"
            }
          }
        },
        "finalize_file": {
          "description": "Close the stream session. Must be called once after all append_chunk calls.",
          "params": {
            "path": {
              "type": "string",
              "required": true,
              "description": "Must match the path used in start_file."
            }
          },
          "returns": {
            "path": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "stream_finalized"
              ]
            },
            "total_bytes": {
              "type": "integer"
            }
          }
        }
      }
    },
    {
      "name": "folder_reader",
      "description": "Given a folder path, walks the entire directory tree, reads all readable text files, and either returns raw structure + content (scan) or forwards everything to the LLM with an optional instruction prompt for analysis, review, summarization, or any code-level task (analyze).",
      "actions": [
        "scan",
        "analyze"
      ],
      "action_schemas": {
        "scan": {
          "description": "Walk folder and return tree structure + file contents as structured data. No LLM call.",
          "params": {
            "folder": {
              "type": "string",
              "required": true,
              "description": "Path to the folder to scan."
            },
            "include_extensions": {
              "type": "array",
              "required": false,
              "description": "Whitelist of extensions e.g. [\".py\", \".js\"]. Omit to include all text files."
            },
            "exclude_extensions": {
              "type": "array",
              "required": false,
              "description": "Blacklist of extensions e.g. [\".lock\", \".min.js\"]."
            },
            "exclude_dirs": {
              "type": "array",
              "required": false,
              "description": "Additional directory names to skip on top of defaults (node_modules, .git, etc.)."
            },
            "max_file_bytes": {
              "type": "integer",
              "required": false,
              "default": 524288,
              "description": "Per-file read cap in bytes. Files larger than this are skipped."
            },
            "follow_symlinks": {
              "type": "boolean",
              "required": false,
              "default": true,
              "description": "Whether to follow symbolic links."
            }
          },
          "returns": {
            "folder": {
              "type": "string"
            },
            "tree": {
              "type": "string",
              "description": "Pretty-printed directory tree."
            },
            "file_count": {
              "type": "integer"
            },
            "skipped_count": {
              "type": "integer"
            },
            "files": {
              "type": "array",
              "description": "List of {rel_path, size_bytes, content}."
            },
            "skipped": {
              "type": "array",
              "description": "List of {rel_path, reason}."
            }
          }
        },
        "analyze": {
          "description": "Walk folder, build context payload, call LLM with optional instruction, return LLM response.",
          "params": {
            "folder": {
              "type": "string",
              "required": true,
              "description": "Path to the folder to analyze."
            },
            "prompt": {
              "type": "string",
              "required": false,
              "description": "Instruction for the LLM e.g. 'Find security issues in this codebase'. Defaults to a general architecture + issue review."
            },
            "include_extensions": {
              "type": "array",
              "required": false,
              "description": "Whitelist of extensions."
            },
            "exclude_extensions": {
              "type": "array",
              "required": false,
              "description": "Blacklist of extensions."
            },
            "exclude_dirs": {
              "type": "array",
              "required": false,
              "description": "Extra dirs to skip."
            },
            "max_file_bytes": {
              "type": "integer",
              "required": false,
              "default": 524288,
              "description": "Per-file read cap in bytes."
            },
            "max_context_bytes": {
              "type": "integer",
              "required": false,
              "default": 204800,
              "description": "Total context cap sent to LLM in bytes."
            },
            "follow_symlinks": {
              "type": "boolean",
              "required": false,
              "default": true,
              "description": "Whether to follow symbolic links."
            }
          },
          "returns": {
            "folder": {
              "type": "string"
            },
            "file_count": {
              "type": "integer"
            },
            "skipped_count": {
              "type": "integer"
            },
            "skipped": {
              "type": "array"
            },
            "prompt": {
              "type": "string"
            },
            "llm_response": {
              "type": "string"
            },
            "context_bytes": {
              "type": "integer"
            }
          }
        }
      }
    }
  ]
