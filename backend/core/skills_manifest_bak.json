  "brain_skills": [
    {
      "name": "memory_manager",
      "description": "Exposes per-user conversation history persistence, listing, and file manipulation directly to the agent.",
      "actions": [
        "retrieve",
        "clear",
        "list_users"
      ],
      "action_schemas": {
        "retrieve": {
          "description": "Retrieve the last 'n' conversation turns as a formatted Markdown string for context.",
          "params": {
            "user_id": {
              "type": "string",
              "required": false,
              "default": "default",
              "description": "Identifier for the target user session history."
            },
            "n": {
              "type": "integer",
              "required": false,
              "default": 10,
              "description": "Number of previous turns to fetch from history."
            }
          },
          "returns": {
            "user_id": {
              "type": "string"
            },
            "history": {
              "type": "string"
            }
          }
        },
        "clear": {
          "description": "Permanently delete the history log file for a specific user ID. Gated behind a confirmation prompt.",
          "params": {
            "user_id": {
              "type": "string",
              "required": false,
              "default": "default",
              "description": "Identifier for the user whose history will be permanently erased."
            }
          },
          "returns": {
            "user_id": {
              "type": "string"
            },
            "cleared": {
              "type": "boolean"
            }
          }
        },
        "list_users": {
          "description": "List all unique user IDs that currently have active conversation history logs saved on disk.",
          "params": {},
          "returns": {
            "users": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ],
  "system_skills": [
    {
      "name": "image_vision",
      "description": "Analyze images using the LLM's vision capability. Supports general analysis, description, OCR text extraction, object/face/logo detection, and two-image comparison. Accepts base64, URL, or local file path as input. [Registry key: image_vision \u2014 matches main.py registration]",
      "actions": [
        "analyze",
        "describe",
        "ocr",
        "detect",
        "compare",
        "check_support"
      ],
      "action_schemas": {
        "analyze": {
          "description": "General-purpose image analysis with a custom prompt.",
          "params": {
            "image_b64": {
              "type": "string",
              "required": false,
              "description": "Base64-encoded image string."
            },
            "image_url": {
              "type": "string",
              "required": false,
              "description": "Publicly accessible image URL."
            },
            "image_path": {
              "type": "string",
              "required": false,
              "description": "Local filesystem path to the image."
            },
            "mime": {
              "type": "string",
              "required": false,
              "default": "image/jpeg",
              "description": "MIME type, e.g., image/png."
            },
            "prompt": {
              "type": "string",
              "required": false,
              "default": "Analyze this image thoroughly and describe everything you observe.",
              "description": "Custom instruction for the model."
            }
          },
          "returns": {
            "action": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "analysis": {
              "type": "string"
            }
          }
        },
        "describe": {
          "description": "Plain-language detailed description of image contents.",
