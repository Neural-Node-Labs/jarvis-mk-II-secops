# ─── AI Agent — Environment Configuration ────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to version control.

# ─── LLM API Keys ─────────────────────────────────────────────────────────────
# DeepSeek (default provider)
DEEPSEEK_API_KEY=sk-...

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (optional)
OPENAI_API_KEY=sk-...

# ─── App Configuration ────────────────────────────────────────────────────────
# Port the web UI is exposed on (default: 3000)
PORT=3000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Filesystem Skill ─────────────────────────────────────────────────────────
# Host path mounted into the container for filesystem access.
# Default "/" gives full host access (agent still confirms destructive actions).
# Scope this down for safer deployments, e.g. HOST_MOUNT=./workspace
HOST_MOUNT=/

# ─── Ollama (if using local Llama models) ─────────────────────────────────────
# If you uncomment the ollama service in docker-compose.yml, the backend
# connects to it automatically at http://ollama:11434/v1
# You can pull models after start:
#   docker compose exec ollama ollama pull llama3
